{
    "manifest_version": 3,
    "name": "Pomodoro Timer",
    "version": "1.0",

    "description": "A pomodoro timer extension designed to perevent the user accessing blocked websites during focus sessions.",

    "permissions": ["alarms", "storage", "declarativeNetRequest", "notifications"],
    "host_permissions": ["<all_urls>"],

    "background": {
        "service_worker": "service-worker.js"
    },
    "action": {
        "default_title": "Pomodoro Timer",
        "default_popup": "popup.html"
    }
}
